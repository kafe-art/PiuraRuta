# ==========================================
# PiuraRuta - Variables de Entorno (OAuth Google)
# ==========================================
# Para obtener estos Client IDs:
# 1. Google Cloud Console -> APIs y Servicios -> Pantalla de consentimiento OAuth
# 2. Credenciales -> Crear ID de cliente OAuth:
#    - Android: paquete "pe.piuraruta.app" + SHA-1
#    - iOS: bundle ID "pe.piuraruta.app"
#    - Web: para clientes web / Expo web
#
# Nota: Si se dejan vacíos, la app entra en modo "Usuario demo" automáticamente.

EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
