{
  "expo": {
    "name": "PiuraRuta",
    "slug": "piuraruta",
    "scheme": "piuraruta",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pe.piuraruta.app"
    },
    "android": {
      "package": "pe.piuraruta.app"
    },
    "web": {},
    "plugins": [
      "expo-web-browser",
      "expo-sharing"
    ]
  }
}
