{
  "expo": {
    "name": "PiuraRuta",
    "slug": "piuraruta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF8C00"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pe.piuraruta.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PiuraRuta necesita tu ubicación para mostrarte los puestos y rutas turísticas más cercanas a pie.",
        "NSCameraUsageDescription": "PiuraRuta requiere acceso a la cámara para postular nuevos puestos informales con foto."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF8C00"
      },
      "package": "pe.piuraruta.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}